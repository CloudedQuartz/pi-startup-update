#!/usr/bin/env bash
set -u

warn() {
  printf 'pi startup updater: %s\n' "$1" >&2
}

pi_bin=${1:-}
if [[ -z "$pi_bin" || ! -x "$pi_bin" ]]; then
  warn 'Pi executable is unavailable; cannot launch Pi.'
  exit 127
fi
shift

lock_fd=
lock_held=0

release_lock() {
  if [[ -n "$lock_fd" ]]; then
    if (( lock_held )); then
      flock -u "$lock_fd" 2>/dev/null || :
    fi
    exec {lock_fd}>&-
    lock_fd=
    lock_held=0
  fi
}

launch_pi() {
  release_lock
  exec "$pi_bin" "$@"
}

# Auto-update only for a plain, foreground interactive launch outside Pi.
if (( $# != 0 )) || [[ ! -t 0 || ! -t 1 ]] || [[ -n "${AI_AGENT:-}" || -n "${PI_CODING_AGENT:-}" ]]; then
  launch_pi "$@"
fi
case "${PI_OFFLINE:-}" in
  1|[Tt][Rr][Uu][Ee]|[Yy][Ee][Ss]) launch_pi "$@" ;;
esac

agent_dir=${PI_CODING_AGENT_DIR:-"$HOME/.pi/agent"}
case "$agent_dir" in
  '~') agent_dir=$HOME ;;
  '~/'*) agent_dir="$HOME/${agent_dir:2}" ;;
esac
lock_file="$agent_dir/.startup-auto-update.lock"
if ! command -v flock >/dev/null 2>&1 || ! exec {lock_fd}>"$lock_file"; then
  warn 'update lock is unavailable; skipping auto-update.'
  launch_pi "$@"
fi
if ! flock -n "$lock_fd"; then
  warn 'another startup update is running; skipping auto-update.'
  launch_pi "$@"
fi
lock_held=1

check_running_pi() {
  local process_names process_name
  process_names=$(ps -eo comm= 2>/dev/null) || return 2
  while IFS= read -r process_name; do
    [[ "$process_name" == pi || "$process_name" == pi-rpc ]] && return 1
  done <<< "$process_names"
  return 0
}

if check_running_pi; then
  :
else
  process_status=$?
  if (( process_status == 1 )); then
    warn 'another Pi or Pi RPC session is active; skipping auto-update.'
  else
    warn 'could not check for active Pi sessions; skipping auto-update.'
  fi
  launch_pi "$@"
fi

# Recheck immediately before updating in case another Pi session started while
# the wrapper was acquiring its lock.
if check_running_pi; then
  :
else
  process_status=$?
  if (( process_status == 1 )); then
    warn 'another Pi or Pi RPC session became active; skipping auto-update.'
  else
    warn 'could not recheck active Pi sessions; skipping auto-update.'
  fi
  launch_pi "$@"
fi

run_update() {
  local label=$1 status
  shift

  "$pi_bin" update "$@" >/dev/null
  status=$?
  if (( status != 0 )); then
    warn "Pi $label update failed (exit $status); starting the installed Pi executable."
    return "$status"
  fi
}

# Use Pi's own updater, scoped to user extensions and core. The extension
# update intentionally follows Pi's normal Git reset/clean and reinstall rules.
if ! run_update extensions --extensions --no-approve; then
  warn 'skipping Pi core update because the extension update failed.'
  launch_pi "$@"
fi

run_update core --self --no-approve || :
launch_pi "$@"
